# --- Talos ---------------------------------------------------------------
ipam:
  mode: kubernetes
# API-server via KubePrism (lokaal op elke node); werkt zonder kube-proxy
k8sServiceHost: localhost
k8sServicePort: 7445
cgroup:
  autoMount:
    enabled: false
  hostRoot: /sys/fs/cgroup
securityContext:
  capabilities:
    ciliumAgent: [CHOWN, KILL, NET_ADMIN, NET_RAW, IPC_LOCK, SYS_ADMIN, SYS_RESOURCE, DAC_OVERRIDE, FOWNER, SETGID, SETUID]
    cleanCiliumState: [NET_ADMIN, SYS_ADMIN, SYS_RESOURCE]

# --- eBPF dataplane --------------------------------------------------------
kubeProxyReplacement: true
bpf:
  masquerade: true

# --- Big Bang: ipBlock-regels in NetworkPolicies laten matchen op node-IP's
# (o.a. egress naar controlPlaneCidr / kube-apiserver)
policyCIDRMatchMode: [nodes]

# --- Istio (Big Bang) ------------------------------------------------------
socketLB:
  hostNamespaceOnly: true
cni:
  exclusive: false

# --- LoadBalancer-IP's via L2 (ARP) i.p.v. MetalLB ------------------------
l2announcements:
  enabled: true
externalIPs:
  enabled: true
# L2-announcements gebruiken leases; hogere client-limieten aanbevolen
k8sClientRateLimit:
  qps: 20
  burst: 40

# --- Overig ----------------------------------------------------------------
operator:
  replicas: 2
hubble:
  enabled: {{ cilium_hubble | bool | lower }}
  relay:
    enabled: {{ cilium_hubble | bool | lower }}
  ui:
    enabled: {{ cilium_hubble | bool | lower }}
